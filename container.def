Bootstrap: docker
From: rocker/r-ver:latest

%labels
    Author Enrico Pezzano
    System Cineca Leonardo
    R_Version (Stable)
    Description Ecological Modelling Container (Biomod2, Terra, Tidyverse)

%help
    This container runs R (Stable Version).
    Contains full stack for ecological modelling: biomod2, terra, maxnet, Hmisc, etc.
    
    Usage on Leonardo:
    apptainer run --bind $WORK:/work,$CINECA_SCRATCH:/scratch tesi.sif

%post
    export DEBIAN_FRONTEND=noninteractive
    export TMPDIR=/var/tmp
    export TMP=/var/tmp
    mkdir -p "$TMPDIR"
    
    # 1. Install System Dependencies
    # Use dist-upgrade to properly handle dependency changes
    apt-get update && apt-get dist-upgrade -y
    
    # Install required packages
    apt-get install -y \
        build-essential \
        gfortran \
        libxml2-dev \
        libcurl4-openssl-dev \
        libssl-dev \
        libfontconfig1-dev \
        libharfbuzz-dev \
        libfribidi-dev \
        libfreetype6-dev \
        libpng-dev \
        libtiff5-dev \
        libjpeg-dev \
        libgdal-dev \
        libgeos-dev \
        libproj-dev \
        libsqlite3-dev \
        libudunits2-dev \
        cmake \
        git \
        vim

    # 2. Create Cineca-specific mount points
    mkdir -p /leonardo
    mkdir -p /work
    mkdir -p /scratch
    mkdir -p /data

    # 3. Install R Packages
    # We use Ncpus to use multiple cores during compilation to speed up the build.
    # Removed quiet=TRUE to see actual errors during installation
    # Added explicit error checking to fail build if packages don't install
    
    Rscript -e 'packages <- c(
        "Hmisc",
        "biomod2",
        "terra",
        "sp",
        "reshape",
        "reshape2",
        "abind",
        "foreach",
        "ggplot2",
        "gbm",
        "rpart",
        "MASS",
        "pROC",
        "PresenceAbsence",
        "dplyr",
        "maxnet",
        "mda",
        "torch",
        "nnet"
    )
    install.packages(packages,
        repos="https://cloud.r-project.org/",
        Ncpus=4,
        dependencies=TRUE)
    
    # Verify all packages installed
    failed <- c()
    for (pkg in packages) {
        if (!require(pkg, character.only=TRUE, quietly=TRUE)) {
            failed <- c(failed, pkg)
        }
    }
    if (length(failed) > 0) {
        cat("\n\nFAILED TO INSTALL:\n")
        cat(paste(failed, collapse="\n"))
        quit(status=1)
    }
    cat("\n\nAll packages installed successfully!\n")'
    
    # 3b. Install torch dependencies (libtorch)
    # This must be done during build time, not runtime, because the container is read-only
    Rscript -e 'torch::install_torch()'

    # 4. Clean up to reduce image size
    apt-get clean > /dev/null
    rm -rf /var/lib/apt/lists/*
    rm -rf /tmp/downloaded_packages

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%runscript
    echo "Starting Ecological Modelling Container..."
    # exec R "$@"
    exec Rscript -e "script_test.r"

%test
    echo "running apptainer test..."
    # Verify critical libraries load
    Rscript -e "library(terra); library(torch); library(biomod2); library(dplyr); print('Core libraries loaded successfully')"
