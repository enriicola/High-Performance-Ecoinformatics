[2026-08-01 18:08:07] +   models.chosen = "all",
[2026-08-01 18:08:07] +   em.by = "all",
[2026-08-01 18:08:07] +   em.algo = c("EMmean", "EMcv"), # c(...) is for multiple options, chose these 2 algorithms because we do not need the median. it does the mean of all models and then does a standard deviation of them (covariance)
[2026-08-01 18:08:07] +   metric.select = "AUCroc", # standard, most used, various articles say it's the best
[2026-08-01 18:08:07] +   metric.select.thresh = 0.6, # threshold value for exclude the models that are not performing over a certain threshold, in this case 0.6
[2026-08-01 18:08:07] +   metric.eval = c("TSS", "AUCroc", "KAPPA"), # 3 most used
[2026-08-01 18:08:07] +   nb.cpu = ensemble_n_cpu
[2026-08-01 18:08:07] + )
