[2026-07-19 23:50:37] + )
[2026-07-19 23:50:37] > 
[2026-07-19 23:50:37] > start.time <- Sys.time()
[2026-07-19 23:50:37] > for (k in 1:nf) {
[2026-07-19 23:50:37] +   scenario_start <- Sys.time()
[2026-07-19 23:50:37] +   name <- lf[k]
[2026-07-19 23:50:37] +   cat("\n\nDEBUG: Processing future scenario", k, "of", nf, ":", name, "\n")
[2026-07-19 23:50:37] + 
[2026-07-19 23:50:37] +   fut_files <- dir(lf[k], full.names = T)
[2026-07-19 23:50:37] +   fut1 <- rast(fut_files)
[2026-07-19 23:50:37] +   cat("DEBUG: Raster loaded, ncell =", ncell(fut1), ", hasValues =", hasValues(fut1), "\n")
[2026-07-19 23:50:37] + 
[2026-07-19 23:50:37] +   fut_proj <- c(fut1[[1]], fut1[[2]], tri_proj, soil_proj[[1]], soil_proj[[2]])
[2026-07-19 23:50:37] +   names(fut_proj) <- c("PC1_clim", "PC2_clim", "tri", "PC1_soil", "PC2_soil")
[2026-07-19 23:50:37] + 
[2026-07-19 23:50:37] +   # path-depth independent: <gcm>/<ssp> are the last two path components
[2026-07-19 23:50:37] +   nm1 <- strsplit(name, "/")[[1]]
