[2026-07-19 21:15:08] > # backend explicitly before building the two ensemble algorithms.
[2026-07-19 21:15:08] > doParallel::registerDoParallel(cores = ensemble_n_cpu)
[2026-07-19 21:15:08] > 
[2026-07-19 21:15:08] > start.time <- Sys.time()
[2026-07-19 21:15:08] > # 4. Model ensemble models
[2026-07-19 21:15:08] > myBiomodEM <- BIOMOD_EnsembleModeling(
[2026-07-19 21:15:08] +   bm.mod = myBiomodModelOut,
[2026-07-19 21:15:08] +   models.chosen = "all",
[2026-07-19 21:15:08] +   em.by = "all",
[2026-07-19 21:15:08] +   em.algo = c("EMmean", "EMcv"), # c(...) is for multiple options, chose these 2 algorithms because we do not need the median. it does the mean of all models and then does a standard deviation of them (covariance)
[2026-07-19 21:15:08] +   metric.select = "AUCroc", # standard, most used, various articles say it's the best
[2026-07-19 21:15:08] +   metric.select.thresh = 0.6, # threshold value for exclude the models that are not performing over a certain threshold, in this case 0.6
[2026-07-19 21:15:08] +   metric.eval = c("TSS", "AUCroc", "KAPPA"), # 3 most used
[2026-07-19 21:15:08] +   nb.cpu = ensemble_n_cpu
[2026-07-19 21:15:08] + )
