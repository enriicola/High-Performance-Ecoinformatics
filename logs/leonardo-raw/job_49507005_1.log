[2026-07-16 03:53:05] +   models.chosen = "all",
[2026-07-16 03:53:05] +   em.by = "all",
[2026-07-16 03:53:05] +   em.algo = c("EMmean", "EMcv"), # c(...) is for multiple options, chose these 2 algorithms because we do not need the median. it does the mean of all models and then does a standard deviation of them (covariance)
[2026-07-16 03:53:05] +   metric.select = "AUCroc", # standard, most used, various articles say it's the best
[2026-07-16 03:53:05] +   metric.select.thresh = 0.6, # threshold value for exclude the models that are not performing over a certain threshold, in this case 0.6
[2026-07-16 03:53:05] +   metric.eval = c("TSS", "AUCroc", "KAPPA"), # 3 most used
[2026-07-16 03:53:05] +   nb.cpu = ensemble_n_cpu
[2026-07-16 03:53:05] + )
