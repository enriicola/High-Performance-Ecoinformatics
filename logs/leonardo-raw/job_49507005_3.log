[2026-07-16 19:47:03] > for (k in 1:nf) {
[2026-07-16 19:47:03] +   scenario_start <- Sys.time()
[2026-07-16 19:47:03] +   name <- lf[k]
[2026-07-16 19:47:03] +   cat("\n\nDEBUG: Processing future scenario", k, "of", nf, ":", name, "\n")
[2026-07-16 19:47:03] + 
[2026-07-16 19:47:03] +   fut_files <- dir(lf[k], full.names = T)
[2026-07-16 19:47:03] +   fut1 <- rast(fut_files)
[2026-07-16 19:47:03] +   cat("DEBUG: Raster loaded, ncell =", ncell(fut1), ", hasValues =", hasValues(fut1), "\n")
[2026-07-16 19:47:03] + 
[2026-07-16 19:47:03] +   fut_proj <- c(fut1[[1]], fut1[[2]], tri_proj, soil_proj[[1]], soil_proj[[2]])
[2026-07-16 19:47:03] +   names(fut_proj) <- c("PC1_clim", "PC2_clim", "tri", "PC1_soil", "PC2_soil")
[2026-07-16 19:47:03] + 
[2026-07-16 19:47:03] +   # path-depth independent: <gcm>/<ssp> are the last two path components
[2026-07-16 19:47:03] +   nm1 <- strsplit(name, "/")[[1]]
[2026-07-16 19:47:03] +   nm <- paste0(nm1[length(nm1) - 1], "_", nm1[length(nm1)])
[2026-07-16 19:47:03] +   nm2 <- paste0("futureEM_", nm1[length(nm1) - 1], "_", nm1[length(nm1)])
[2026-07-16 19:47:03] + 
[2026-07-16 19:47:03] +   # 5. Individual models projections on future environmental conditions
[2026-07-16 19:47:03] +   projection_start <- Sys.time()
[2026-07-16 19:47:03] +   myBiomodProj_fut <- BIOMOD_Projection(
[2026-07-16 19:47:03] +     bm.mod = myBiomodModelOut,
[2026-07-16 19:47:03] +     proj.name = nm,
[2026-07-16 19:47:03] +     new.env = fut_proj,
[2026-07-16 19:47:03] +     models.chosen = "all",
[2026-07-16 19:47:03] +     build.clamping.mask = T,
[2026-07-16 19:47:03] +     keep.in.memory = FALSE, # OOM fix: free per-model rasters from RAM after write
[2026-07-16 19:47:03] +     do.stack = FALSE, # OOM fix: write per-model .tif to disk instead of stacking all layers in memory
[2026-07-16 19:47:03] +     nb.cpu = n_cpu
[2026-07-16 19:47:03] +   )
[2026-07-16 19:47:03] +   projection_end <- Sys.time()
[2026-07-16 19:47:03] + 
[2026-07-16 19:47:03] +   doParallel::registerDoParallel(cores = ensemble_n_cpu)
[2026-07-16 19:47:03] +   ensemble_start <- Sys.time()
[2026-07-16 19:47:03] +   myBiomodEMProj_fut <- BIOMOD_EnsembleForecasting(
[2026-07-16 19:47:03] +     bm.em = myBiomodEM,
[2026-07-16 19:47:03] +     bm.proj = myBiomodProj_fut, # reuse computed projection; biomod2 wants XOR(bm.proj, new.env)
[2026-07-16 19:47:03] +     proj.name = nm2,
[2026-07-16 19:47:03] +     models.chosen = "all",
[2026-07-16 19:47:03] +     metric.binary = "all",
[2026-07-16 19:47:03] +     metric.filter = "all",
[2026-07-16 19:47:03] +     nb.cpu = ensemble_n_cpu
[2026-07-16 19:47:03] +   )
[2026-07-16 19:47:03] +   ensemble_end <- Sys.time()
[2026-07-16 19:47:03] + 
[2026-07-16 19:47:03] +   future_timings <- rbind(
[2026-07-16 19:47:03] +     future_timings,
[2026-07-16 19:47:03] +     data.frame(
[2026-07-16 19:47:03] +       scenario = nm,
