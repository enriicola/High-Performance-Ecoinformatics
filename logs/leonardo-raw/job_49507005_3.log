[2026-07-16 19:47:03] +       ensemble_secs = as.numeric(ensemble_end - ensemble_start, units = "secs"),
[2026-07-16 19:47:03] +       total_secs = as.numeric(ensemble_end - scenario_start, units = "secs")
[2026-07-16 19:47:03] +     )
[2026-07-16 19:47:03] +   )
