[14:50:23] > ## Number of future projections
[14:50:23] > # 5 global circulation models (GCM), variazione di gas serra, metano, etc, nell'atmosfera nel futuro, e all'interno di ognuno ci sono due scenari (ottimista SSP370 e pessimista SSP585), TODO check acronyms
[14:50:23] > # 10 future projections (5 GCM x 2 SSP) -> 10 proiezioni future per ogni specie
[14:50:23] > # calibrazione solo su current (presente), per avere una base di partenza, e la proiezione serve due volte
[14:50:23] > # proiezione sul futuro viene fatta partendo dai dati del primo (e unico) biomod modelling e sulle var ambientali future, per vedere come cambiano le predizioni
[14:50:23] > 
[14:50:23] > nf <- length(lf)
[14:50:23] > 
[14:50:23] > start.time <- Sys.time()
[14:50:23] > for (k in 1:nf) {
[14:50:23] +   name <- lf[k]
[14:50:23] +   cat("\n\nDEBUG: Processing future scenario", k, "of", nf, ":", name, "\n")
[14:50:23] + 
[14:50:23] +   fut_files <- dir(lf[k], full.names = T)
[14:50:23] +   fut1 <- rast(fut_files)
[14:50:23] +   cat("DEBUG: Raster loaded, ncell =", ncell(fut1), ", hasValues =", hasValues(fut1), "\n")
[14:50:23] + 
[14:50:23] +   fut <- fut1
[14:50:23] +   fut_proj <- c(fut[[1]], fut[[2]], tri_proj, soil_proj[[1]], soil_proj[[2]])
[14:50:23] +   names(fut_proj) <- c("PC1_clim", "PC2_clim", "tri", "PC1_soil", "PC2_soil")
[14:50:23] + 
[14:50:23] +   # path-depth independent: <gcm>/<ssp> are the last two path components
[14:50:23] +   nm1 <- strsplit(name, "/")[[1]]
[14:50:23] +   nm <- paste0(nm1[length(nm1) - 1], "_", nm1[length(nm1)])
[14:50:23] +   nm2 <- paste0("futureEM_", nm1[length(nm1) - 1], "_", nm1[length(nm1)])
[14:50:23] + 
[14:50:23] +   # 5. Individual models projections on future environmental conditions
[14:50:23] +   myBiomodProj_fut <- BIOMOD_Projection(
[14:50:23] +     bm.mod = myBiomodModelOut,
[14:50:23] +     proj.name = nm,
[14:50:23] +     new.env = fut_proj,
[14:50:23] +     models.chosen = "all",
[14:50:23] +     build.clamping.mask = T,
[14:50:23] +     keep.in.memory = FALSE, # OOM fix: free per-model rasters from RAM after write
[14:50:23] +     do.stack = FALSE, # OOM fix: write per-model .tif to disk instead of stacking all layers in memory
[14:50:23] +     nb.cpu = n_cpu
[14:50:23] +   )
[14:50:23] + 
[14:50:23] +   myBiomodEMProj_fut <- BIOMOD_EnsembleForecasting(
[14:50:23] +     bm.em = myBiomodEM,
[14:50:23] +     bm.proj = myBiomodProj_fut, # reuse computed projection; biomod2 wants XOR(bm.proj, new.env)
[14:50:23] +     proj.name = nm2,
[14:50:23] +     models.chosen = "all",
[14:50:23] +     metric.binary = "all",
[14:50:23] +     metric.filter = "all",
[14:50:23] +     nb.cpu = 1
[14:50:23] +   )
[14:50:23] + }
