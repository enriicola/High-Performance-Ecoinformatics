[2026-08-02 23:35:42] +   metric.eval = c("TSS", "AUCroc", "KAPPA"), # 3 most used
[2026-08-02 23:35:42] +   nb.cpu = ensemble_n_cpu
[2026-08-02 23:35:42] + )
