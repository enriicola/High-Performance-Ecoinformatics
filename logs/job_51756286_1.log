[2026-08-03 00:52:13] > ## Number of future projections
[2026-08-03 00:52:13] > # 5 global circulation models (GCM), variazione di gas serra, metano, etc, nell'atmosfera nel futuro, e all'interno di ognuno ci sono due scenari (ottimista SSP370 e pessimista SSP585), TODO check acronyms
[2026-08-03 00:52:13] > # 10 future projections (5 GCM x 2 SSP) -> 10 proiezioni future per ogni specie
[2026-08-03 00:52:13] > # calibrazione solo su current (presente), per avere una base di partenza, e la proiezione serve due volte
[2026-08-03 00:52:13] > # proiezione sul futuro viene fatta partendo dai dati del primo (e unico) biomod modelling e sulle var ambientali future, per vedere come cambiano le predizioni
[2026-08-03 00:52:13] > 
[2026-08-03 00:52:13] > nf <- length(lf)
[2026-08-03 00:52:13] > future_timings <- data.frame(
[2026-08-03 00:52:13] +   scenario = character(),
[2026-08-03 00:52:13] +   projection_secs = numeric(),
[2026-08-03 00:52:13] +   ensemble_secs = numeric(),
[2026-08-03 00:52:13] +   total_secs = numeric()
[2026-08-03 00:52:13] + )
[2026-08-03 00:52:13] > 
[2026-08-03 00:52:13] > start.time <- Sys.time()
[2026-08-03 00:52:13] > for (k in 1:nf) {
[2026-08-03 00:52:13] +   scenario_start <- Sys.time()
[2026-08-03 00:52:13] +   name <- lf[k]
[2026-08-03 00:52:13] +   cat("\n\nDEBUG: Processing future scenario", k, "of", nf, ":", name, "\n")
[2026-08-03 00:52:13] + 
[2026-08-03 00:52:13] +   fut_files <- dir(lf[k], full.names = T)
[2026-08-03 00:52:13] +   fut1 <- rast(fut_files)
[2026-08-03 00:52:13] +   cat("DEBUG: Raster loaded, ncell =", ncell(fut1), ", hasValues =", hasValues(fut1), "\n")
[2026-08-03 00:52:13] + 
[2026-08-03 00:52:13] +   fut_proj <- c(fut1[[1]], fut1[[2]], tri_proj, soil_proj[[1]], soil_proj[[2]])
[2026-08-03 00:52:13] +   names(fut_proj) <- c("PC1_clim", "PC2_clim", "tri", "PC1_soil", "PC2_soil")
[2026-08-03 00:52:13] + 
[2026-08-03 00:52:13] +   # path-depth independent: <gcm>/<ssp> are the last two path components
[2026-08-03 00:52:13] +   nm1 <- strsplit(name, "/")[[1]]
[2026-08-03 00:52:13] +   nm <- paste0(nm1[length(nm1) - 1], "_", nm1[length(nm1)])
[2026-08-03 00:52:13] +   nm2 <- paste0("futureEM_", nm1[length(nm1) - 1], "_", nm1[length(nm1)])
[2026-08-03 00:52:13] + 
[2026-08-03 00:52:13] +   # 5. Individual models projections on future environmental conditions
[2026-08-03 00:52:13] +   projection_start <- Sys.time()
[2026-08-03 00:52:13] +   myBiomodProj_fut <- BIOMOD_Projection(
[2026-08-03 00:52:13] +     bm.mod = myBiomodModelOut,
[2026-08-03 00:52:13] +     proj.name = nm,
[2026-08-03 00:52:13] +     new.env = fut_proj,
[2026-08-03 00:52:13] +     models.chosen = "all",
[2026-08-03 00:52:13] +     build.clamping.mask = T,
[2026-08-03 00:52:13] +     keep.in.memory = projection_keep_in_memory,
[2026-08-03 00:52:13] +     do.stack = projection_do_stack,
[2026-08-03 00:52:13] +     nb.cpu = n_cpu
[2026-08-03 00:52:13] +   )
[2026-08-03 00:52:13] +   projection_end <- Sys.time()
[2026-08-03 00:52:13] + 
[2026-08-03 00:52:13] +   doParallel::registerDoParallel(cores = ensemble_n_cpu)
[2026-08-03 00:52:13] +   ensemble_start <- Sys.time()
[2026-08-03 00:52:13] +   myBiomodEMProj_fut <- BIOMOD_EnsembleForecasting(
[2026-08-03 00:52:13] +     bm.em = myBiomodEM,
[2026-08-03 00:52:13] +     bm.proj = myBiomodProj_fut, # reuse computed projection; biomod2 wants XOR(bm.proj, new.env)
[2026-08-03 00:52:13] +     proj.name = nm2,
[2026-08-03 00:52:13] +     models.chosen = "all",
[2026-08-03 00:52:13] +     metric.binary = "all",
[2026-08-03 00:52:13] +     metric.filter = "all",
[2026-08-03 00:52:13] +     nb.cpu = ensemble_n_cpu
[2026-08-03 00:52:13] +   )
[2026-08-03 00:52:13] +   ensemble_end <- Sys.time()
[2026-08-03 00:52:13] + 
[2026-08-03 00:52:13] +   future_timings <- rbind(
[2026-08-03 00:52:13] +     future_timings,
[2026-08-03 00:52:13] +     data.frame(
[2026-08-03 00:52:13] +       scenario = nm,
[2026-08-03 00:52:13] +       projection_secs = as.numeric(projection_end - projection_start, units = "secs"),
[2026-08-03 00:52:13] +       ensemble_secs = as.numeric(ensemble_end - ensemble_start, units = "secs"),
[2026-08-03 00:52:13] +       total_secs = as.numeric(ensemble_end - scenario_start, units = "secs")
[2026-08-03 00:52:13] +     )
[2026-08-03 00:52:13] +   )
[2026-08-03 00:52:13] + 
