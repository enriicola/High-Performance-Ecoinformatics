[2026-08-02 23:35:42] +   em.by = "all",
[2026-08-02 23:35:42] +   em.algo = c("EMmean", "EMcv"), # c(...) is for multiple options, chose these 2 algorithms because we do not need the median. it does the mean of all models and then does a standard deviation of them (covariance)
