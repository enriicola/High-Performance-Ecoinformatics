[2026-08-30 23:08:20] +   bm.em = myBiomodEM,
[2026-08-30 23:08:20] +   bm.proj = myBiomodProj, # reuse computed projection; biomod2 wants XOR(bm.proj, new.env)
[2026-08-30 23:08:20] +   proj.name = "CurrentEM",
[2026-08-30 23:08:20] +   models.chosen = "all",
[2026-08-30 23:08:20] +   metric.binary = "all",
[2026-08-30 23:08:20] +   metric.filter = "all",
[2026-08-30 23:08:20] +   nb.cpu = ensemble_n_cpu
[2026-08-30 23:08:20] + )
